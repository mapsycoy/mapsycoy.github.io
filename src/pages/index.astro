---
import Layout from "../layouts/Layout.astro";
import RecentPosts from "../components/RecentPosts.astro";
import SeoulLocationMap from "../components/SeoulLocationMap.astro";
import HandwrittenEmail from "../components/HandwrittenEmail.astro";
import { getHomeCaption, getHomeContact, getHomeGreeting } from "../data/home";

const homeContact = getHomeContact();
const homeGreeting = getHomeGreeting();
const homeGreetingLines = homeGreeting.split(/\r?\n/).filter(Boolean);
const homeCaption = getHomeCaption();
---

<Layout homeSketch>
  <section class="home-landing">
    <div class="home-kicker">Greeting</div>

    <div class="home-copy">
      <h1 class="title">
        {homeGreetingLines.map((line) => <span>{line}</span>)}
      </h1>
    </div>

    <RecentPosts />

    <div class="home-location-row">
      <span class="home-location-icon" aria-label="Location">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 2.5c-3.6 0-6.5 2.9-6.5 6.5 0 4.9 6.5 12.5 6.5 12.5S18.5 13.9 18.5 9c0-3.6-2.9-6.5-6.5-6.5Zm0 9a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5Z" />
        </svg>
      </span>
      <span class="home-location-name">Republic of Korea / Seoul</span>
      <time data-seoul-time datetime="">00/00/0000 00:00:00 KST</time>
      <SeoulLocationMap />
    </div>

    <div class="home-contact">
      <div class="home-contact-row">
        <span class="home-contact-label" aria-hidden="true">{homeContact.label}</span>
        <button
          type="button"
          class="home-contact-address"
          data-home-contact-copy
          data-contact-email={homeContact.email}
          data-contact-copied={homeContact.copied}
          aria-label={`이메일 주소 ${homeContact.email} 복사`}
        >
          <span class="home-contact-glyph" aria-hidden="true">▛▚▞▜ ▞▚ █ ▙</span>
          <span class="home-contact-real"><HandwrittenEmail /></span>
        </button>
      </div>
    </div>

    <div class="home-caption">
      {homeCaption.split(/\n\s*\n/).map((paragraph) => <p set:html={paragraph} />)}
    </div>
  </section>

  <script>
    const initializeHomeContactCopy = () => {
      document.querySelectorAll("[data-home-contact-copy]").forEach((button) => {
      if (!(button instanceof HTMLButtonElement) || button.dataset.contactBound === "true") return;
      button.dataset.contactBound = "true";
      let copyFeedbackTimeout = 0;

      button.addEventListener("click", async () => {
        const address = button.dataset.contactEmail || "mapsycoy@gmail.com";
        let copied = false;

        try {
          if (!navigator.clipboard?.writeText) throw new Error("Clipboard API unavailable");
          await navigator.clipboard.writeText(address);
          copied = true;
        } catch {
          const textarea = document.createElement("textarea");
          textarea.value = address;
          textarea.setAttribute("readonly", "");
          textarea.style.position = "fixed";
          textarea.style.opacity = "0";
          document.body.appendChild(textarea);
          textarea.select();
          try {
            copied = document.execCommand("copy");
          } catch {
            copied = false;
          } finally {
            textarea.remove();
          }
        }

        if (copied) {
          button.classList.add("is-copied");
          window.clearTimeout(copyFeedbackTimeout);
          copyFeedbackTimeout = window.setTimeout(() => {
            button.classList.remove("is-copied");
          }, 1600);
        }

      });
      });
    };
    const initializeSeoulTime = () => {
      document.querySelectorAll("[data-seoul-time]").forEach((timeElement) => {
      if (!(timeElement instanceof HTMLTimeElement) || timeElement.dataset.timeBound === "true") return;
      timeElement.dataset.timeBound = "true";
      if (!(timeElement instanceof HTMLTimeElement)) return;

      const formatter = new Intl.DateTimeFormat("en-GB", {
        timeZone: "Asia/Seoul",
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
        hour12: false
      });

      const updateSeoulTime = () => {
        const now = new Date();
        timeElement.dateTime = now.toISOString();
        timeElement.textContent = `${formatter.format(now).replace(",", "")} KST`;
      };

      updateSeoulTime();
      window.setInterval(updateSeoulTime, 1000);
      });
    };

    const initializeHomeLanding = () => {
      initializeHomeContactCopy();
      initializeSeoulTime();
    };

    window.__mapsycoyInitializeHomeLanding = initializeHomeLanding;

    if (!window.__mapsycoyHomeLandingEventsBound) {
      window.__mapsycoyHomeLandingEventsBound = true;
      document.addEventListener("astro:page-load", () => window.__mapsycoyInitializeHomeLanding?.());
      document.addEventListener("DOMContentLoaded", () => window.__mapsycoyInitializeHomeLanding?.());
    }

    initializeHomeLanding();
  </script>
</Layout>
