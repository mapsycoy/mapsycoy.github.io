---
import NoteArticle from "../../../components/NoteArticle.astro";
import { getNotes, type NoteEntry } from "../../../data/notes";
import { defaultLanguage } from "../../../utils/i18n";

export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}

const { note } = Astro.props as { note: NoteEntry };
---

<NoteArticle note={note} lang={defaultLanguage} />
