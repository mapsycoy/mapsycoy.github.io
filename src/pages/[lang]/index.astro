---
import Layout from "../../layouts/Layout.astro";
import HomeManifesto from "../../components/HomeManifesto.astro";
import { getLanguageFromParams, languages, type Language } from "../../utils/i18n";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang: Language = getLanguageFromParams(Astro.params.lang);
---

<Layout lang={lang} homeSketch homeWalkSpeed={0.5}>
  <HomeManifesto lang={lang} />
</Layout>
