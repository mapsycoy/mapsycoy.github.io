---
import BlogSearchResults from "../../../components/BlogSearchResults.astro";
import Layout from "../../../layouts/Layout.astro";
import { getLanguageFromParams, languages, type Language } from "../../../utils/i18n";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang: Language = getLanguageFromParams(Astro.params.lang);
---

<Layout title="Search" description="Search essays, paper reviews, and news notes by mapsycoy." lang={lang}>
  <BlogSearchResults lang={lang} />
</Layout>