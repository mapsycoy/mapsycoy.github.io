---
import NotesIndex from "../../../../components/NotesIndex.astro";
import { getNotes } from "../../../../data/notes";
import { getLanguageFromParams, languages, type Language } from "../../../../utils/i18n";

export function getStaticPaths() {
  return languages.map((lang) => ({
    params: { lang },
    props: { lang: getLanguageFromParams(lang) },
  }));
}

const { lang } = Astro.props as { lang: Language };
const notes = await getNotes();
---

<NotesIndex notes={notes} lang={lang} />
