---
import "../styles/global.css";
import LogoMark from "../components/LogoMark.astro";
import HomeFooterSketch from "../components/HomeFooterSketch.astro";
import { getSitePreviewImage } from "../data/home";
import { defaultLanguage, getAlternateLanguage, isLanguage, withLanguage, type Language } from "../utils/i18n";

const {
  title = "mapsycoy",
  description = "Visual Creation, AI Workflows, and Human-Centered Interaction.",
  previewImage = getSitePreviewImage(),
  lang = defaultLanguage,
  ogType = "website",
  publishedTime = undefined,
  modifiedTime = undefined,
  preconnectX = false,
  homeSketch = false
} = Astro.props;

const currentLanguage = lang as Language;
const siteUrl = Astro.site ?? Astro.url.origin;
const pageTitle = title === "mapsycoy" ? "mapsycoy" : `${title} | mapsycoy`;
const pageUrl = new URL(Astro.url.pathname, siteUrl).toString();
const previewImageUrl = new URL(previewImage, siteUrl).toString();
const faviconBase = "https://cdn.jsdelivr.net/gh/mapsycoy/mapsycoy-assets@ce70fc3/uploads/site";
const favicons = [
  { extension: "ico", type: "image/x-icon", sizes: "16x16 32x32 48x48" },
  { extension: "png", type: "image/png", sizes: "32x32" },
  { extension: "svg", type: "image/svg+xml", sizes: "any" }
];

const navItems = [
  { href: withLanguage(currentLanguage, "/works"), label: "Works" },
  { href: withLanguage(currentLanguage, "/blog"), label: "Blog" },
  { href: withLanguage(currentLanguage, "/cv"), label: "CV" }
];
const pathParts = Astro.url.pathname.split("/").filter(Boolean);
const hasLanguagePrefix = isLanguage(pathParts[0]);
const rawBasePath = hasLanguagePrefix ? `/${pathParts.slice(1).join("/")}` : Astro.url.pathname;
const basePath = rawBasePath === "" || rawBasePath === "/"
  ? "/"
  : `${rawBasePath.replace(/\/+$/, "")}/`;
const enUrl = new URL(basePath, siteUrl).toString();
const koUrl = new URL(`/ko${basePath}`, siteUrl).toString();
const canonicalUrl = currentLanguage === "ko" ? koUrl : enUrl;
const alternateLanguage = getAlternateLanguage(currentLanguage);
const alternatePath = withLanguage(alternateLanguage, basePath);
const isDuplicateLanguageRoute = hasLanguagePrefix && pathParts[0] === defaultLanguage;

const linkedInUrl = "https://www.linkedin.com/in/mapsycoy/";
const instagramUrl = "https://www.instagram.com/mapsycoy/";
---

<!doctype html>
<html lang={currentLanguage}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {favicons.map(({ extension, type, sizes }) => (
      <link
        rel="icon"
        type={type}
        sizes={sizes}
        href={`${faviconBase}/favicon${extension === "svg" ? "" : "-light"}.${extension}`}
        data-favicon
        data-light={`${faviconBase}/favicon-light.${extension}`}
        data-dark={`${faviconBase}/favicon-dark.${extension}`}
      />
    ))}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    {preconnectX && (
      <>
        <link rel="preconnect" href="https://platform.x.com" />
        <link rel="preconnect" href="https://syndication.twitter.com" />
        <link rel="preconnect" href="https://pbs.twimg.com" crossorigin />
        <link rel="dns-prefetch" href="https://cdn.syndication.twimg.com" />
        <link rel="preload" as="script" href="https://platform.x.com/widgets.js" />
      </>
    )}
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard/dist/web/static/pretendard.css" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f8f7f2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171817" media="(prefers-color-scheme: dark)" />
    <meta name="description" content={description} />
    <meta property="og:type" content={ogType} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={previewImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={previewImageUrl} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="ko" href={koUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <link rel="alternate" type="application/rss+xml" title="mapsycoy — All" href="/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title="mapsycoy — Essays & Papers" href="/rss-essays.xml" />
    <link rel="alternate" type="application/rss+xml" title="mapsycoy — News" href="/rss-news.xml" />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        const colorSchemeQuery = window.matchMedia("(prefers-color-scheme: dark)");
        const storageKey = "mapsycoy-theme";
        const getStoredTheme = () => {
          try {
            const value = localStorage.getItem(storageKey);
            return value === "dark" || value === "light" ? value : null;
          } catch {
            return null;
          }
        };
        const getTheme = () => getStoredTheme() ?? (colorSchemeQuery.matches ? "dark" : "light");
        const setFaviconTheme = (root, theme) => {
          root.ownerDocument.querySelectorAll("link[data-favicon]").forEach((link) => {
            const href = link.dataset[theme];
            if (href && link.getAttribute("href") !== href) link.setAttribute("href", href);
          });
        };
        const setColorTheme = (root = document.documentElement) => {
          root.dataset.theme = getTheme();
          setFaviconTheme(root, root.dataset.theme);
        };
        const updateToggle = () => {
          const button = document.querySelector("[data-theme-toggle]");
          if (!(button instanceof HTMLButtonElement)) return;
          const isDark = document.documentElement.dataset.theme === "dark";
          button.setAttribute("aria-pressed", isDark ? "true" : "false");
          button.setAttribute("aria-label", isDark ? "Switch to light mode" : "Switch to dark mode");
        };
        window.mapsycoyToggleTheme = () => {
          const nextTheme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
          try { localStorage.setItem(storageKey, nextTheme); } catch {}
          document.documentElement.dataset.theme = nextTheme;
          setFaviconTheme(document.documentElement, nextTheme);
          updateToggle();
        };

        setColorTheme();
        const handleThemeChange = () => {
          if (getStoredTheme()) return;
          setColorTheme();
          updateToggle();
        };
        if (!window.__mapsycoyThemeSync) {
          window.__mapsycoyThemeSync = true;
          if (typeof colorSchemeQuery.addEventListener === "function") {
            colorSchemeQuery.addEventListener("change", handleThemeChange);
          } else if (typeof colorSchemeQuery.addListener === "function") {
            colorSchemeQuery.addListener(handleThemeChange);
          }
          document.addEventListener("astro:before-swap", (event) => {
            setColorTheme(event.newDocument.documentElement);
          });
        }

        document.addEventListener("DOMContentLoaded", updateToggle);
        document.addEventListener("astro:page-load", updateToggle);
      })();
    </script>
    <style is:inline>
      html { overflow-y: scroll; }
    </style>
  </head>
  <body data-pagefind-ignore={isDuplicateLanguageRoute ? "all" : undefined}>
    <div class="site-shell">
      <header class="site-header" aria-label="Site header">
        <a class="site-title" href={withLanguage(currentLanguage, "/")} aria-label="mapsycoy home">
          <LogoMark />
        </a>
        <nav class="site-nav" aria-label="Primary navigation">
          {navItems.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
          <span class="site-nav-controls">
            <button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="Switch color theme" onclick="window.mapsycoyToggleTheme()">
              <svg class="theme-toggle-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3.5" /><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M18.7 5.3l-1.4 1.4M6.7 17.3l-1.4 1.4" /></svg>
              <svg class="theme-toggle-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 15.2A8.4 8.4 0 0 1 8.8 4 8.5 8.5 0 1 0 20 15.2Z" /></svg>
            </button>
            <a class="language-toggle" href={alternatePath} aria-label={`Switch to ${alternateLanguage.toUpperCase()}`}>
              {alternateLanguage.toUpperCase()}
            </a>
          </span>
        </nav>
      </header>

      <main class:list={{ "home-main": homeSketch }}>
        <slot />
      </main>
      <footer class:list={["site-footer", homeSketch && "has-home-sketch"]}>
        {homeSketch && <HomeFooterSketch lang={currentLanguage} />}
        <p class="footer-copyright">
          <svg viewBox="0 0 24 24" aria-label="Copyright">
            <circle cx="12" cy="12" r="8.5" />
            <path d="M15 9.2a4 4 0 1 0 0 5.6" />
          </svg>
          <span>Kim Junyeop. All rights reserved.</span>
        </p>
        <div class="footer-social-links">
          <a
            class="footer-social-link"
            href={linkedInUrl}
            target="_blank"
            rel="noreferrer"
            aria-label="Kim Junyeop on LinkedIn"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5.35 8.85h3.12v9.78H5.35V8.85Zm1.56-4.86c1 0 1.81.81 1.81 1.81s-.81 1.81-1.81 1.81S5.1 6.8 5.1 5.8s.81-1.81 1.81-1.81Zm3.47 4.86h2.99v1.34h.04c.42-.79 1.43-1.62 2.95-1.62 3.15 0 3.73 2.07 3.73 4.76v5.3h-3.12v-4.7c0-1.12-.02-2.56-1.56-2.56-1.56 0-1.8 1.22-1.8 2.48v4.78h-3.23V8.85Z" />
            </svg>
          </a>
          <a
            class="footer-social-link"
            href={instagramUrl}
            target="_blank"
            rel="noreferrer"
            aria-label="mapsycoy on Instagram"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M7.75 2.9h8.5a4.85 4.85 0 0 1 4.85 4.85v8.5a4.85 4.85 0 0 1-4.85 4.85h-8.5a4.85 4.85 0 0 1-4.85-4.85v-8.5A4.85 4.85 0 0 1 7.75 2.9Zm0 1.9A2.95 2.95 0 0 0 4.8 7.75v8.5a2.95 2.95 0 0 0 2.95 2.95h8.5a2.95 2.95 0 0 0 2.95-2.95v-8.5a2.95 2.95 0 0 0-2.95-2.95h-8.5Zm4.25 3a4.2 4.2 0 1 1 0 8.4 4.2 4.2 0 0 1 0-8.4Zm0 1.9a2.3 2.3 0 1 0 0 4.6 2.3 2.3 0 0 0 0-4.6Zm4.45-2.25a1.05 1.05 0 1 1 0 2.1 1.05 1.05 0 0 1 0-2.1Z" />
            </svg>
          </a>
        </div>
      </footer>
    </div>

    <script is:inline>
      const initializeWorksFilters = () => {
        document.querySelectorAll("[data-works-filter]").forEach((filterRoot) => {
          if (!(filterRoot instanceof HTMLElement) || filterRoot.dataset.filterBound === "true") return;
          filterRoot.dataset.filterBound = "true";

          const buttons = Array.from(filterRoot.querySelectorAll("[data-filter]"));
          const toggleButton = filterRoot.querySelector("[data-filter-toggle]");
          const workCards = Array.from(document.querySelectorAll("[data-work-card]"));
          const workSections = Array.from(document.querySelectorAll("[data-work-section]"));

          const applyFilter = (activeButton) => {
            const filter = activeButton.dataset.filter ?? "all";

            buttons.forEach((button) => {
              const isActive = button === activeButton;
              button.classList.toggle("is-active", isActive);
              button.setAttribute("aria-pressed", isActive ? "true" : "false");
            });

            workCards.forEach((card) => {
              if (!(card instanceof HTMLElement)) return;
              const tags = card.dataset.tags ?? "";
              const shouldShow = filter === "all" || tags.split(" ").includes(filter);
              card.hidden = !shouldShow;
            });

            workSections.forEach((section) => {
              if (!(section instanceof HTMLElement)) return;
              const cards = Array.from(section.querySelectorAll("[data-work-card]"));
              const hasVisibleCard = cards.some((card) => card instanceof HTMLElement && !card.hidden);
              section.hidden = !hasVisibleCard;
            });
          };

          buttons.forEach((button) => {
            button.addEventListener("click", () => applyFilter(button));
          });

          if (toggleButton instanceof HTMLButtonElement) {
            toggleButton.addEventListener("click", () => {
              const willExpand = !filterRoot.classList.contains("is-expanded");
              filterRoot.classList.toggle("is-expanded", willExpand);
              const icon = toggleButton.querySelector(".works-filter-toggle-icon");
              if (icon) icon.textContent = willExpand ? "−" : "+";
              toggleButton.setAttribute("aria-expanded", willExpand ? "true" : "false");
              toggleButton.setAttribute("aria-label", willExpand ? "Show fewer categories" : "Show more categories");

              if (!willExpand) {
                const allButton = buttons.find((button) => button.dataset.filter === "all");
                if (allButton instanceof HTMLButtonElement) applyFilter(allButton);
              }
            });
          }
        });
      };

      const initializeBlogFilters = () => {
        document.querySelectorAll("[data-blog-filter]").forEach((filterRoot) => {
          if (!(filterRoot instanceof HTMLElement) || filterRoot.dataset.filterBound === "true") return;
          filterRoot.dataset.filterBound = "true";

          const entries = Array.from(document.querySelectorAll("[data-blog-entry]"));
          const pagination = document.querySelector("[data-blog-pagination]");
          const pageSize = pagination instanceof HTMLElement ? Number(pagination.dataset.pageSize ?? "8") : 8;
          const pageNumbers = pagination?.querySelector("[data-page-numbers]");
          let currentFilter = "all";
          let currentPage = 1;

          const getFilteredEntries = () => entries.filter((entry) => {
            if (!(entry instanceof HTMLElement)) return false;
            const tags = entry.dataset.tags ?? "";
            return currentFilter === "all" || tags.split(" ").includes(currentFilter);
          });

          const renderEntries = () => {
            const filteredEntries = getFilteredEntries();
            const pageCount = Math.max(1, Math.ceil(filteredEntries.length / pageSize));
            currentPage = Math.min(currentPage, pageCount);
            const startIndex = (currentPage - 1) * pageSize;
            const visibleEntries = filteredEntries.slice(startIndex, startIndex + pageSize);

            entries.forEach((entry) => {
              if (!(entry instanceof HTMLElement)) return;
              entry.classList.remove("is-first-visible", "is-last-visible");
              entry.hidden = !visibleEntries.includes(entry);
            });

            visibleEntries[0]?.classList.add("is-first-visible");
            visibleEntries[visibleEntries.length - 1]?.classList.add("is-last-visible");

            if (pagination instanceof HTMLElement) pagination.hidden = false;

            if (pageNumbers instanceof HTMLElement) {
              Array.from(pageNumbers.querySelectorAll("[data-page-number]")).forEach((button) => {
                if (!(button instanceof HTMLButtonElement)) return;
                const page = Number(button.dataset.pageNumber ?? "1");
                const isVisiblePage = page <= pageCount;
                const isActivePage = page === currentPage;
                button.hidden = !isVisiblePage;
                button.classList.toggle("is-active", isActivePage);
                if (isActivePage) {
                  button.setAttribute("aria-current", "page");
                } else {
                  button.removeAttribute("aria-current");
                }
              });
            }
          };

          const buttons = Array.from(filterRoot.querySelectorAll("[data-filter]"));
          buttons.forEach((button) => {
            button.addEventListener("click", () => {
              currentFilter = button.dataset.filter ?? "all";
              currentPage = 1;

              buttons.forEach((item) => {
                const isActive = item === button;
                item.classList.toggle("is-active", isActive);
                item.setAttribute("aria-pressed", isActive ? "true" : "false");
              });

              renderEntries();
            });
          });

          if (pageNumbers instanceof HTMLElement) {
            pageNumbers.addEventListener("click", (event) => {
              const target = event.target;
              if (!(target instanceof HTMLButtonElement)) return;
              currentPage = Number(target.dataset.pageNumber ?? "1");
              renderEntries();
            });
          }

          renderEntries();
        });
      };

      const initializeCvToggles = () => {
        document.querySelectorAll("[data-cv-section]").forEach((section) => {
          if (!(section instanceof HTMLElement)) return;

          const toggle = section.querySelector("[data-cv-toggle]");
          if (!(toggle instanceof HTMLButtonElement) || toggle.dataset.cvToggleBound === "true") return;
          toggle.dataset.cvToggleBound = "true";

          const items = Array.from(section.querySelectorAll("[data-cv-item]"));
          const initialCount = Number(toggle.dataset.initialCount ?? items.length);
          const totalCount = Number(toggle.dataset.totalCount ?? items.length);
          const label = toggle.dataset.label ?? "items";

          const setExpanded = (isExpanded) => {
            items.forEach((item, index) => {
              if (!(item instanceof HTMLElement)) return;
              item.hidden = !isExpanded && index >= initialCount;
            });

            toggle.setAttribute("aria-expanded", isExpanded ? "true" : "false");
            toggle.textContent = isExpanded
              ? "Show fewer"
              : `Show all ${totalCount} ${label}`;
          };

          toggle.addEventListener("click", () => {
            setExpanded(toggle.getAttribute("aria-expanded") !== "true");
          });
        });
      };

      const positionFootnotePopover = (wrap) => {
        const trigger = wrap.querySelector(".footnote-ref");
        const popover = wrap.querySelector(".footnote-popover");
        if (!(trigger instanceof HTMLElement) || !(popover instanceof HTMLElement)) return;

        // Measure in the final positioning mode without widening the mobile viewport.
        popover.classList.add("is-positioned");

        requestAnimationFrame(() => {
          const margin = 20;
          const gap = 8;
          const triggerRect = trigger.getBoundingClientRect();
          const popoverRect = popover.getBoundingClientRect();
          const left = Math.min(
            document.documentElement.clientWidth - margin - popoverRect.width,
            Math.max(margin, triggerRect.left + (triggerRect.width / 2) - (popoverRect.width / 2))
          );
          const top = Math.max(margin, triggerRect.top - popoverRect.height - gap);

          popover.style.setProperty("--footnote-popover-left", `${Math.round(left)}px`);
          popover.style.setProperty("--footnote-popover-top", `${Math.round(top)}px`);
        });
      };

      const initializeNoteTables = () => {
        document.querySelectorAll(".note-body table").forEach((table) => {
          if (!(table instanceof HTMLTableElement) || table.parentElement?.classList.contains("markdown-table-scroll")) return;
          const wrapper = document.createElement("div");
          wrapper.className = "markdown-table-scroll";
          table.before(wrapper);
          wrapper.append(table);
        });
      };
      const initializeFootnotePopovers = () => {
        const toSuperscriptNumber = (value) => String(value).replace(/[0-9]/g, (digit) => "⁰¹²³⁴⁵⁶⁷⁸⁹"[Number(digit)]);

        document.querySelectorAll(".note-body [data-footnote-ref]").forEach((reference) => {
          if (!(reference instanceof HTMLAnchorElement)) return;
          const wrap = reference.parentElement;
          const targetId = reference.getAttribute("href")?.slice(1);
          const definition = targetId ? document.getElementById(targetId) : null;
          if (!(wrap instanceof HTMLElement) || !(definition instanceof HTMLElement)) return;

          const number = reference.textContent?.trim() || "";
          const content = definition.querySelector("p")?.cloneNode(true);
          if (!(content instanceof HTMLElement)) return;
          content.querySelectorAll("[data-footnote-backref]").forEach((backref) => backref.remove());

          const trigger = document.createElement("button");
          trigger.type = "button";
          trigger.className = "footnote-ref";
          trigger.setAttribute("aria-label", `Footnote ${number}`);
          trigger.textContent = toSuperscriptNumber(number);

          const popover = document.createElement("span");
          popover.className = "footnote-popover";
          popover.setAttribute("role", "note");
          popover.innerHTML = content.innerHTML.trim();

          wrap.classList.add("footnote-ref-wrap");
          wrap.replaceChildren(trigger, popover);

          if (!definition.querySelector(".footnote-label")) {
            const label = document.createElement("span");
            label.className = "footnote-label";
            label.textContent = toSuperscriptNumber(number);
            definition.prepend(label);
          }
          definition.querySelectorAll("[data-footnote-backref]").forEach((backref) => backref.remove());
        });
        document.querySelectorAll(".footnote-ref-wrap").forEach((wrap) => {
          if (!(wrap instanceof HTMLElement) || wrap.dataset.footnoteBound === "true") return;
          wrap.dataset.footnoteBound = "true";

          const update = () => positionFootnotePopover(wrap);
          const clear = () => {
            const popover = wrap.querySelector(".footnote-popover");
            if (popover instanceof HTMLElement) popover.classList.remove("is-positioned");
          };

          wrap.addEventListener("pointerenter", update);
          wrap.addEventListener("focusin", update);
          wrap.addEventListener("click", update);
          wrap.addEventListener("pointerleave", clear);
          wrap.addEventListener("focusout", clear);
        });
      };

      window.addEventListener("resize", () => {
        document.querySelectorAll(".footnote-ref-wrap:focus-within, .footnote-ref-wrap:hover").forEach((wrap) => {
          if (wrap instanceof HTMLElement) positionFootnotePopover(wrap);
        });
      }, { passive: true });
      const initializeAdaptiveHeader = () => {
        if (window.__mapsycoyAdaptiveHeaderBound) return;
        window.__mapsycoyAdaptiveHeaderBound = true;

        let lastScrollY = window.scrollY;
        let idleTimer;

        const getHeader = () => document.querySelector(".site-header");
        const showHeader = () => getHeader()?.classList.remove("is-hidden");
        const hideHeader = () => {
          const header = getHeader();
          if (window.scrollY > 8 && !header?.matches(":hover, :focus-within")) {
            header?.classList.add("is-hidden");
          }
        };
        const scheduleIdleHide = () => {
          window.clearTimeout(idleTimer);
          if (window.scrollY > 8) idleTimer = window.setTimeout(hideHeader, 1400);
        };
        const resetHeader = () => {
          window.clearTimeout(idleTimer);
          lastScrollY = window.scrollY;
          showHeader();
          scheduleIdleHide();
        };

        window.addEventListener("scroll", () => {
          const currentScrollY = window.scrollY;
          const delta = currentScrollY - lastScrollY;

          if (currentScrollY <= 8) {
            window.clearTimeout(idleTimer);
            showHeader();
          } else if (delta > 3) {
            window.clearTimeout(idleTimer);
            hideHeader();
          } else if (delta < -3) {
            showHeader();
            scheduleIdleHide();
          }

          lastScrollY = currentScrollY;
        }, { passive: true });

        document.addEventListener("focusin", (event) => {
          if (event.target instanceof Element && event.target.closest(".site-header")) {
            window.clearTimeout(idleTimer);
            showHeader();
          }
        });
        document.addEventListener("focusout", (event) => {
          if (event.target instanceof Element && event.target.closest(".site-header")) scheduleIdleHide();
        });
        document.addEventListener("pointerover", (event) => {
          if (event.target instanceof Element && event.target.closest(".site-header")) {
            window.clearTimeout(idleTimer);
            showHeader();
          }
        });
        document.addEventListener("pointerout", (event) => {
          const header = event.target instanceof Element ? event.target.closest(".site-header") : null;
          if (header && !(event.relatedTarget instanceof Node && header.contains(event.relatedTarget))) {
            scheduleIdleHide();
          }
        });
        document.addEventListener("astro:page-load", resetHeader);
        resetHeader();
      };

      initializeAdaptiveHeader();
      const initializePageInteractions = () => {
        initializeWorksFilters();
        initializeBlogFilters();
        initializeCvToggles();
        initializeNoteTables();
        initializeFootnotePopovers();
      };

      document.addEventListener("astro:page-load", initializePageInteractions);
      document.addEventListener("DOMContentLoaded", initializePageInteractions);
      initializePageInteractions();
      const protectImages = () => {
        document.querySelectorAll("img").forEach((image) => {
          image.setAttribute("draggable", "false");
        });
      };

      document.addEventListener("contextmenu", (event) => {
        if (event.target instanceof HTMLImageElement) {
          event.preventDefault();
        }
      });

      document.addEventListener("dragstart", (event) => {
        if (event.target instanceof HTMLImageElement) {
          event.preventDefault();
        }
      });

      document.addEventListener("DOMContentLoaded", protectImages);
      protectImages();
    </script>
  </body>
</html>
