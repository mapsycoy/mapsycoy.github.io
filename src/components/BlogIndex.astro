---
import BlogSearch from "./BlogSearch.astro";
import BlogFilterNav from "./BlogFilterNav.astro";
import BlogSeriesCarousel from "./BlogSeriesCarousel.astro";
import {
  getNonSeriesPosts,
  getBlogPostSlug,
  getBlogPageCount,
  getPostSeriesMetadata,
  formatPostDate,
  formatTitlePunctuation,
  getPostDateLabel,
  hasKoreanText,
  type BlogPost,
  type BlogTag,
} from "../data/blog";
import { defaultLanguage, localize, type Language } from "../utils/i18n";
import { getNotes } from "../data/notes";
import { getSeriesEntryPosition } from "../data/seriesEntries";

type Props = {
  posts: BlogPost[];
  allPosts: BlogPost[];
  seriesPosts?: BlogPost[];
  lang?: Language;
  currentPage?: number;
  basePath?: string;
  activeTag?: BlogTag;
  hub?: boolean;
  hubPosts?: BlogPost[];
  pageCountOverride?: number;
};

const {
  posts,
  allPosts,
  seriesPosts = allPosts,
  lang = defaultLanguage,
  currentPage = 1,
  basePath = "/blog",
  activeTag,
  hub = false,
  hubPosts = allPosts,
  pageCountOverride,
} = Astro.props;

const normalizedBasePath = `/${basePath.replace(/^\/+|\/+$/g, "")}`;
const pageCount = pageCountOverride ?? getBlogPageCount(allPosts);
const toPagePath = (page: number) => {
  if (page <= 1) return `${normalizedBasePath}/`;
  return `${normalizedBasePath}/page/${page}/`;
};
const languagePrefix = lang === defaultLanguage ? "" : `/${lang}`;
const notes = await getNotes();
const nonSeriesPosts = hub ? getNonSeriesPosts(hubPosts) : [];
const getPostTitle = (post: BlogPost) => formatTitlePunctuation(localize(post.data.title, lang));
const getPostSeriesPositionLabel = (post: BlogPost) => {
  const position = getSeriesEntryPosition(seriesPosts, notes, { kind: "blog", item: post });
  if (!position) return "";
  return `${String(position.index + 1).padStart(2, "0")}/${String(position.entries.length).padStart(2, "0")}`;
};
const paginationItems = (() => {
  const pages = new Set([1, pageCount, currentPage - 1, currentPage, currentPage + 1]);
  const sortedPages = [...pages]
    .filter((page) => page >= 1 && page <= pageCount)
    .sort((a, b) => a - b);
  const items: Array<number | "ellipsis"> = [];

  sortedPages.forEach((page) => {
    const previous = items[items.length - 1];
    if (typeof previous === "number" && page - previous > 1) items.push("ellipsis");
    items.push(page);
  });

  return items;
})();
---

<BlogFilterNav lang={lang} activeTag={activeTag} />

{hub && currentPage === 1 && (
  <div class="blog-inline-search" style="min-height: 48px; margin-bottom: 28px;">
    <BlogSearch lang={lang} embedded />
  </div>
)}

{hub && currentPage === 1 ? (
  <div class="blog-hub">
    <BlogSeriesCarousel posts={hubPosts} notes={notes} lang={lang} />
    {nonSeriesPosts.length > 0 && (
      <section class="blog-text-section blog-news-archive" aria-labelledby="other-posts-title">
        <h2 id="other-posts-title" class="blog-section-label">{lang === "ko" ? "시리즈 외 글" : "Other writing"}</h2>
        <ul class="blog-text-list">
          {nonSeriesPosts.map((post) => (
            <li><a href={`${languagePrefix}/blog/${getBlogPostSlug(post)}/`}><span class="blog-news-title" style="font-size:0.82rem;line-height:1.35;min-height:1.11rem;">{getPostTitle(post)}</span><time datetime={post.data.publishedAt.toISOString()}>{formatPostDate(post.data.publishedAt)}</time></a></li>
          ))}
        </ul>
      </section>
    )}

    <section class="blog-text-section blog-news-archive" aria-labelledby="news-archive-title">
      <h2 id="news-archive-title" class="blog-section-label">News / Archive</h2>
      <ul class="blog-text-list">
        {posts.map((post) => (
          <li><a href={`${languagePrefix}/blog/${getBlogPostSlug(post)}/`}><span class="blog-news-title" style="font-size:0.82rem;line-height:1.35;min-height:1.11rem;">{getPostTitle(post)}</span><time datetime={post.data.publishedAt.toISOString()}>{formatPostDate(post.data.publishedAt)}</time></a></li>
        ))}
      </ul>
    </section>
  </div>
) : (
<section class="entry-list blog-entry-list" aria-label="Blog entries">
  {posts.map((post, index) => (
    <article
      class:list={[
        "blog-entry",
        index === 0 && "is-first-visible",
        index === posts.length - 1 && "is-last-visible"
      ]}
    >
      <a class="blog-entry-link" href={`${languagePrefix}/blog/${getBlogPostSlug(post)}/`} aria-label={`Open ${getPostTitle(post)} post`}>
        <div class="blog-entry-copy">
          {(!activeTag || post.data.pinned || getPostSeriesMetadata(post)) && (
            <p class="entry-meta blog-entry-meta">
              {post.data.pinned && (
                <span class="pin-icon" aria-label="Pinned post">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M14.7 3.3 20.7 9.3 18.6 11.4 17.2 10 13 14.2V18L11.7 19.3 8.8 16.4 4.4 20.8 3.2 19.6 7.6 15.2 4.7 12.3 6 11H9.8L14 6.8 12.6 5.4 14.7 3.3Z" />
                  </svg>
                </span>
              )}
              {!activeTag && <span>{post.data.tag}</span>}
              {activeTag && getPostSeriesMetadata(post) && (
                <span class="blog-entry-series-meta">
                  Series {String(getPostSeriesMetadata(post)?.number).padStart(2, "0")} · {getPostSeriesPositionLabel(post)}
                </span>
              )}
            </p>
          )}
          <h2 class:list={[hasKoreanText(getPostTitle(post)) && "ko-title"]}>{getPostTitle(post)}</h2>
          <p class="blog-entry-date" style="font-size:0.64rem;line-height:1.4;min-height:0.9rem;font-variant-numeric:tabular-nums;">
            {getPostDateLabel(post.data.publishedAt, post.data.updatedAt)}
          </p>
        </div>
        <div class="blog-entry-thumb" aria-label={`${getPostTitle(post)} thumbnail`}>
          {post.data.thumbnail ? (
            <img
              src={post.data.thumbnail}
              alt={post.data.thumbnailAlt ? localize(post.data.thumbnailAlt, lang) : ""}
              style={post.data.thumbnailPosition ? { objectPosition: post.data.thumbnailPosition } : undefined}
              loading="lazy"
            />
          ) : (
            <div class="blog-entry-thumb-placeholder" aria-hidden="true"></div>
          )}
        </div>
      </a>
    </article>
  ))}
</section>
)}

{pageCount > 1 && (
  <nav class="blog-pagination" aria-label="Blog pagination">
    <div class="blog-pagination-side blog-pagination-previous">
      {currentPage > 1 && (
        <a class="blog-page-button blog-page-arrow" href={toPagePath(currentPage - 1)} aria-label="Previous page">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="m14.5 5-7 7 7 7" />
          </svg>
        </a>
      )}
    </div>
    <div class="blog-page-numbers">
      {paginationItems.map((item) => {
        if (item === "ellipsis") {
          return <span class="blog-page-ellipsis" aria-hidden="true">...</span>;
        }

        return (
          <a
            class:list={["blog-page-button", item === currentPage && "is-active"]}
            href={toPagePath(item)}
            aria-current={item === currentPage ? "page" : undefined}
          >
            {item}
          </a>
        );
      })}
    </div>
    <div class="blog-pagination-side blog-pagination-next">
      {currentPage < pageCount && (
        <a class="blog-page-button blog-page-arrow" href={toPagePath(currentPage + 1)} aria-label="Next page">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="m9.5 5 7 7-7 7" />
          </svg>
        </a>
      )}
    </div>
  </nav>
)}
