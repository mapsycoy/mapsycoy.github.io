---
import BlogSearch from "./BlogSearch.astro";
import {
  blogTags,
  getNonSeriesPosts,
  getBlogPostSlug,
  getBlogPageCount,
  getPostSeriesMetadata,
  getSeriesGroups,
  formatPostDate,
  formatTitlePunctuation,
  getPostDateLabel,
  hasKoreanText,
  normalizeBlogTag,
  type BlogPost,
  type BlogTag,
} from "../data/blog";
import { defaultLanguage, localize, type Language } from "../utils/i18n";

type Props = {
  posts: BlogPost[];
  allPosts: BlogPost[];
  lang?: Language;
  currentPage?: number;
  basePath?: string;
  activeTag?: BlogTag;
  hub?: boolean;
  hubPosts?: BlogPost[];
  pageCountOverride?: number;
};

const {
  posts,
  allPosts,
  lang = defaultLanguage,
  currentPage = 1,
  basePath = "/blog",
  activeTag,
  hub = false,
  hubPosts = allPosts,
  pageCountOverride,
} = Astro.props;

const normalizedBasePath = `/${basePath.replace(/^\/+|\/+$/g, "")}`;
const pageCount = pageCountOverride ?? getBlogPageCount(allPosts);
const toPagePath = (page: number) => {
  if (page <= 1) return `${normalizedBasePath}/`;
  return `${normalizedBasePath}/page/${page}/`;
};
const languagePrefix = lang === defaultLanguage ? "" : `/${lang}`;
const allPath = `${languagePrefix}/blog/`;
const tagPath = (tag: BlogTag) => `${languagePrefix}/blog/tag/${normalizeBlogTag(tag)}/`;
const seriesGroups = hub ? getSeriesGroups(hubPosts) : [];
const nonSeriesPosts = hub ? getNonSeriesPosts(hubPosts) : [];
const getPostTitle = (post: BlogPost) => formatTitlePunctuation(localize(post.data.title, lang));
const paginationItems = (() => {
  const pages = new Set([1, pageCount, currentPage - 1, currentPage, currentPage + 1]);
  const sortedPages = [...pages]
    .filter((page) => page >= 1 && page <= pageCount)
    .sort((a, b) => a - b);
  const items: Array<number | "ellipsis"> = [];

  sortedPages.forEach((page) => {
    const previous = items[items.length - 1];
    if (typeof previous === "number" && page - previous > 1) items.push("ellipsis");
    items.push(page);
  });

  return items;
})();
---

<div class="blog-filters">
  <section class="works-filter blog-filter-row" aria-label={lang === "ko" ? "형식으로 거르기" : "Filter blog entries by format"}>
    <a class:list={["work-filter-button", !activeTag && "is-active"]} href={allPath} aria-current={!activeTag ? "page" : undefined}>All</a>
    {blogTags.map((tag) => (
      <a class:list={["work-filter-button", activeTag === tag && "is-active"]} href={tagPath(tag)} aria-current={activeTag === tag ? "page" : undefined}>{tag}</a>
    ))}
  </section>
</div>

{hub && currentPage === 1 && (
  <div class="blog-inline-search">
    <BlogSearch lang={lang} embedded />
  </div>
)}

{hub && currentPage === 1 ? (
  <div class="blog-hub">
    <div class="blog-series-index">
    {seriesGroups.map((group) => (
      <section id={`series-${group.id}`} class="blog-text-section blog-series-block" aria-labelledby={`series-${group.id}-title`}>
        <details class="blog-series-stack">
          <summary class="blog-series-intro">
            <span class="blog-series-kicker">Series {String(group.metadata.number).padStart(2, "0")}</span>
            <h1 id={`series-${group.id}-title`}>{localize(group.metadata.title, lang)}</h1>
            <span class="blog-series-description">{localize(group.metadata.description, lang).split(/\n\s*\n/).map((paragraph) => <span>{paragraph}</span>)}</span>
            <span class="blog-series-action">
              <span class="blog-series-count">{lang === "ko" ? `${group.posts.length}편` : `${group.posts.length} posts`}</span>
              {group.isArchived && <span class="blog-series-status">{lang === "ko" ? "완결" : "Archived"}</span>}
              <span class="blog-series-action-label">
                <span class="when-closed">{lang === "ko" ? "메모 펼치기" : "Unfold notes"}</span>
                <span class="when-open">{lang === "ko" ? "메모 접기" : "Fold notes"}</span>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 9 7 7 7-7" /></svg>
              </span>
            </span>
          </summary>
          <svg class="blog-series-tree" aria-hidden="true"><path data-series-tree-path /></svg>
          <div class="blog-series-notes">
            {group.posts.map((post, index) => (
              <a
                class="blog-series-entry"
                href={`${languagePrefix}/blog/${getBlogPostSlug(post)}/`}
                style={`--series-index: ${index}`}
              >
                <span class="blog-series-entry-number">{String(index + 1).padStart(2, "0")}</span>
                <h2 class:list={[hasKoreanText(getPostTitle(post)) && "ko-title"]}>{getPostTitle(post)}</h2>
                <span class="blog-series-entry-meta">
                  <span>{post.data.tag}</span>
                  <time datetime={post.data.publishedAt.toISOString()}>{formatPostDate(post.data.publishedAt)}</time>
                </span>
              </a>
            ))}
          </div>
        </details>
      </section>
    ))}
    </div>
    {nonSeriesPosts.length > 0 && (
      <section class="blog-text-section" aria-labelledby="other-posts-title">
        <h2 id="other-posts-title">{lang === "ko" ? "시리즈 외 글" : "Other writing"}</h2>
        <ul class="blog-text-list">
          {nonSeriesPosts.map((post) => (
            <li><a href={`${languagePrefix}/blog/${getBlogPostSlug(post)}/`}><span>{getPostTitle(post)}</span><time datetime={post.data.publishedAt.toISOString()}>{formatPostDate(post.data.publishedAt)}</time></a></li>
          ))}
        </ul>
      </section>
    )}

    <section class="blog-text-section blog-news-archive" aria-labelledby="news-archive-title">
      <h2 id="news-archive-title" class="blog-section-label">News / Archive</h2>
      <ul class="blog-text-list">
        {posts.map((post) => (
          <li><a href={`${languagePrefix}/blog/${getBlogPostSlug(post)}/`}><span class="blog-news-title" style="font-size:0.82rem;line-height:1.35;min-height:1.11rem;">{getPostTitle(post)}</span><time datetime={post.data.publishedAt.toISOString()}>{formatPostDate(post.data.publishedAt)}</time></a></li>
        ))}
      </ul>
    </section>
  </div>
) : (
<section class="entry-list blog-entry-list" aria-label="Blog entries">
  {posts.map((post, index) => (
    <article
      class:list={[
        "blog-entry",
        index === 0 && "is-first-visible",
        index === posts.length - 1 && "is-last-visible"
      ]}
    >
      <a class="blog-entry-link" href={`${languagePrefix}/blog/${getBlogPostSlug(post)}/`} aria-label={`Open ${getPostTitle(post)} post`}>
        <div class="blog-entry-copy">
          {(!activeTag || post.data.pinned || getPostSeriesMetadata(post)) && (
            <p class="entry-meta blog-entry-meta">
              {post.data.pinned && (
                <span class="pin-icon" aria-label="Pinned post">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M14.7 3.3 20.7 9.3 18.6 11.4 17.2 10 13 14.2V18L11.7 19.3 8.8 16.4 4.4 20.8 3.2 19.6 7.6 15.2 4.7 12.3 6 11H9.8L14 6.8 12.6 5.4 14.7 3.3Z" />
                  </svg>
                </span>
              )}
              {!activeTag && <span>{post.data.tag}</span>}
              {activeTag && getPostSeriesMetadata(post) && (
                <span class="blog-entry-series-meta">
                  Series {String(getPostSeriesMetadata(post)?.number).padStart(2, "0")}
                  {" · "}
                  {localize(getPostSeriesMetadata(post)!.title, lang)}
                </span>
              )}
            </p>
          )}
          <h2 class:list={[hasKoreanText(getPostTitle(post)) && "ko-title"]}>{getPostTitle(post)}</h2>
          <p class="blog-entry-date" style="font-size:0.64rem;line-height:1.4;min-height:0.9rem;font-variant-numeric:tabular-nums;">
            {getPostDateLabel(post.data.publishedAt, post.data.updatedAt)}
          </p>
        </div>
        <div class="blog-entry-thumb" aria-label={`${getPostTitle(post)} thumbnail`}>
          {post.data.thumbnail ? (
            <img src={post.data.thumbnail} alt="" loading="lazy" />
          ) : (
            <div class="blog-entry-thumb-placeholder" aria-hidden="true"></div>
          )}
        </div>
      </a>
    </article>
  ))}
</section>
)}

{pageCount > 1 && (
  <nav class="blog-pagination" aria-label="Blog pagination">
    <div class="blog-pagination-side blog-pagination-previous">
      {currentPage > 1 && (
        <a class="blog-page-button blog-page-arrow" href={toPagePath(currentPage - 1)} aria-label="Previous page">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="m14.5 5-7 7 7 7" />
          </svg>
        </a>
      )}
    </div>
    <div class="blog-page-numbers">
      {paginationItems.map((item) => {
        if (item === "ellipsis") {
          return <span class="blog-page-ellipsis" aria-hidden="true">...</span>;
        }

        return (
          <a
            class:list={["blog-page-button", item === currentPage && "is-active"]}
            href={toPagePath(item)}
            aria-current={item === currentPage ? "page" : undefined}
          >
            {item}
          </a>
        );
      })}
    </div>
    <div class="blog-pagination-side blog-pagination-next">
      {currentPage < pageCount && (
        <a class="blog-page-button blog-page-arrow" href={toPagePath(currentPage + 1)} aria-label="Next page">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="m9.5 5 7 7-7 7" />
          </svg>
        </a>
      )}
    </div>
  </nav>
)}
<script is:inline>
  (() => {
    const drawSeriesTree = (stack) => {
      const svg = stack.querySelector(".blog-series-tree");
      const path = svg?.querySelector("[data-series-tree-path]");
      const intro = stack.querySelector(".blog-series-intro");
      const notes = stack.querySelector(".blog-series-notes");
      const entries = [...stack.querySelectorAll(".blog-series-entry")];
      if (!svg || !path || !intro || !notes || !stack.open || !entries.length) return;

      const stackWidth = stack.clientWidth;
      const stackHeight = stack.clientHeight;
      const notesLeft = notes.offsetLeft;
      const notesTop = notes.offsetTop;
      const introLeft = intro.offsetLeft;
      const introTop = intro.offsetTop;
      const introRight = introLeft + intro.offsetWidth;
      const introBottom = introTop + intro.offsetHeight;
      const trunkX = notesLeft;
      const endX = notesLeft + entries[0].offsetLeft - 0.5;
      const centers = entries.map((entry) => notesTop + entry.offsetTop + entry.offsetHeight / 2);
      const stacked = notesTop >= introBottom - 1;
      const startX = stacked
        ? introLeft + Math.min(28, intro.offsetWidth / 4)
        : introRight;
      const startY = stacked
        ? introBottom
        : introTop + intro.offsetHeight / 2;
      const elbowY = stacked
        ? introBottom + Math.max(6, Math.min(14, (notesTop - introBottom) / 2))
        : startY;
      const trunkTop = Math.min(elbowY, centers[0]);
      const trunkBottom = Math.max(startY, centers[centers.length - 1]);
      const commands = [
        stacked
          ? `M ${startX} ${startY} V ${elbowY} H ${trunkX}`
          : `M ${startX} ${startY} H ${trunkX}`,
        `M ${trunkX} ${trunkTop} V ${trunkBottom}`,
        ...centers.map((center) => `M ${trunkX} ${center} H ${endX}`),
      ];

      svg.setAttribute("viewBox", `0 0 ${stackWidth} ${stackHeight}`);
      path.setAttribute("d", commands.join(" "));
    };

    const drawAllSeriesTrees = () => {
      document.querySelectorAll("details.blog-series-stack").forEach((stack) => drawSeriesTree(stack));
    };

    const setupSeriesTrees = () => {
      document.querySelectorAll("details.blog-series-stack").forEach((stack) => {
        if (!stack.dataset.treeReady) {
          stack.dataset.treeReady = "true";
          stack.addEventListener("toggle", () => {
            const notes = stack.querySelector(".blog-series-notes");
            notes?.classList.remove("is-unfolding");
            if (stack.open && notes) {
              void notes.offsetWidth;
              notes.classList.add("is-unfolding");
            }
            requestAnimationFrame(() => drawSeriesTree(stack));
          });
          new ResizeObserver(() => drawSeriesTree(stack)).observe(stack);
        }
      });
      requestAnimationFrame(drawAllSeriesTrees);
    };

    const openLinkedSeries = () => {
      if (!window.location.hash.startsWith("#series-")) return;
      document.querySelector(window.location.hash)?.querySelector("details.blog-series-stack")?.setAttribute("open", "");
    };
    openLinkedSeries();
    setupSeriesTrees();
    if (window.__mapsycoySeriesHashNavigation) return;
    window.__mapsycoySeriesHashNavigation = true;
    document.addEventListener("astro:page-load", () => {
      openLinkedSeries();
      setupSeriesTrees();
    });
    window.addEventListener("hashchange", openLinkedSeries);
    window.addEventListener("resize", () => requestAnimationFrame(drawAllSeriesTrees));
  })();
</script>