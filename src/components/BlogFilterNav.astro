---
import { blogTags, normalizeBlogTag, type BlogTag } from "../data/blog";
import { defaultLanguage, type Language } from "../utils/i18n";

type Props = {
  lang?: Language;
  activeTag?: BlogTag;
  activeNotes?: boolean;
};

const { lang = defaultLanguage, activeTag, activeNotes = false } = Astro.props;
const languagePrefix = lang === defaultLanguage ? "" : `/${lang}`;
const allPath = `${languagePrefix}/blog/`;
const tagPath = (tag: BlogTag) => `${languagePrefix}/blog/tag/${normalizeBlogTag(tag)}/`;
const notesPath = `${languagePrefix}/blog/notes/`;
---

<div class="blog-filters">
  <nav class="works-filter blog-filter-row" aria-label={lang === "ko" ? "블로그 카테고리" : "Blog categories"}>
    <a class:list={["work-filter-button", !activeTag && !activeNotes && "is-active"]} href={allPath} aria-current={!activeTag && !activeNotes ? "page" : undefined}>All</a>
    {blogTags.map((tag) => (
      <a class:list={["work-filter-button", activeTag === tag && "is-active"]} href={tagPath(tag)} aria-current={activeTag === tag ? "page" : undefined}>{tag}</a>
    ))}
    <a class:list={["work-filter-button", "blog-notes-entry", activeNotes && "is-active"]} href={notesPath} aria-current={activeNotes ? "page" : undefined} aria-label="Notes">
      <span class="blog-notes-entry-label">Notes</span>
      <svg class="blog-notes-entry-icon" viewBox="0 0 24 24" aria-hidden="true">
        <defs>
          <filter id="notes-scribble" x="-15%" y="-15%" width="130%" height="130%">
            <feTurbulence type="fractalNoise" baseFrequency="0.08 0.16" numOctaves="2" seed="7" result="noise" />
            <feDisplacementMap in="SourceGraphic" in2="noise" scale="0.75" xChannelSelector="R" yChannelSelector="G" />
          </filter>
        </defs>
        <g class="blog-notes-scribble" filter="url(#notes-scribble)">
          <g class="blog-notes-graph-edges">
            <path class="is-strong" d="M7.7 14.8C9.1 12.4 11.4 10.4 14.1 9.1" />
            <path d="M14.3 9C16.6 10.3 18.3 12.8 19 15.8" />
            <path d="M7.1 14.3C5.8 11.5 5 8.4 4.4 5.5" />
            <path class="is-strong" d="M14.5 8.5C13.4 6.7 12 5.2 10.4 3.9" />
            <path d="M15 8.6C16.8 6.8 18.5 5.8 20.6 5.2" />
            <path d="M9 17.1C10.4 18.2 11.8 19.4 13 20.6" />
            <path class="is-membership" d="M8.8 15.5C12.1 15.1 15.1 15.3 18.7 16.2" />
          </g>
          <path class="blog-notes-graph-hub-echo" d="M3.7 14.5c.1-2.4 1.7-4.1 4-4 2.5.1 4.2 2 4 4.5-.2 2.5-1.8 4.1-4.3 4-2.3-.1-3.8-2-3.7-4.5Z" />
          <path class="blog-notes-graph-hub" d="M4.4 14.6c.1-1.9 1.4-3.3 3.3-3.2 2 .1 3.4 1.5 3.3 3.6-.2 2-1.5 3.3-3.5 3.2-1.9-.1-3.2-1.6-3.1-3.6Z" />
          <path class="blog-notes-graph-core" d="M12.3 8.9c0-1.3.9-2.3 2.2-2.3 1.4.1 2.4 1.1 2.3 2.5-.1 1.3-1 2.2-2.4 2.2-1.3-.1-2.2-1.1-2.1-2.4Z" />
          <path class="blog-notes-graph-outline" d="M17.1 16.1c0-1.1.8-1.9 1.9-1.9 1.2.1 2 .9 1.9 2.1-.1 1.1-.9 1.9-2 1.8-1.1 0-1.8-.9-1.8-2Z" />
          <path class="blog-notes-graph-node" d="M3.3 5.4c0-.7.5-1.2 1.2-1.2s1.2.6 1.1 1.3c0 .7-.5 1.1-1.2 1.1-.7 0-1.1-.5-1.1-1.2Z" />
          <path class="blog-notes-graph-node is-tiny" d="M9.5 3.8c0-.5.4-.9.9-.9.6 0 1 .4.9 1 0 .5-.4.9-.9.9-.6-.1-.9-.5-.9-1Z" />
          <path class="blog-notes-graph-node is-tiny" d="M19.8 5.1c0-.5.4-.9.9-.9.6.1.9.5.9 1 0 .5-.4.9-1 .9-.5 0-.8-.5-.8-1Z" />
          <path class="blog-notes-graph-node" d="M11.8 20.5c0-.7.5-1.2 1.2-1.2s1.2.6 1.1 1.3c0 .7-.5 1.1-1.2 1.1-.7 0-1.1-.5-1.1-1.2Z" />
        </g>
      </svg>
    </a>
  </nav>
</div>
