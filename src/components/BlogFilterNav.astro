---
import { blogTags, normalizeBlogTag, type BlogTag } from "../data/blog";
import { defaultLanguage, type Language } from "../utils/i18n";

type Props = {
  lang?: Language;
  activeTag?: BlogTag;
  activeNotes?: boolean;
};

const { lang = defaultLanguage, activeTag, activeNotes = false } = Astro.props;
const languagePrefix = lang === defaultLanguage ? "" : `/${lang}`;
const allPath = `${languagePrefix}/blog/`;
const tagPath = (tag: BlogTag) => `${languagePrefix}/blog/tag/${normalizeBlogTag(tag)}/`;
const notesPath = `${languagePrefix}/blog/notes/`;
---

<div class="blog-filters">
  <nav class="works-filter blog-filter-row" aria-label={lang === "ko" ? "블로그 카테고리" : "Blog categories"}>
    <a class:list={["work-filter-button", !activeTag && !activeNotes && "is-active"]} href={allPath} aria-current={!activeTag && !activeNotes ? "page" : undefined}>All</a>
    {blogTags.map((tag) => (
      <a class:list={["work-filter-button", activeTag === tag && "is-active"]} href={tagPath(tag)} aria-current={activeTag === tag ? "page" : undefined}>{tag}</a>
    ))}
    <a class:list={["work-filter-button", "blog-notes-entry", activeNotes && "is-active"]} href={notesPath} aria-current={activeNotes ? "page" : undefined} aria-label="Notes">
      <span class="blog-notes-entry-label">Notes</span>
      <svg class="blog-notes-entry-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M2.8 3.2c5.5-.4 12.9-.3 18.3.1.4 4.8.4 12.7-.2 17.5-5.2.4-12.8.3-17.8-.2-.4-4.9-.5-12.6-.2-17.4Z" />
        <g transform="translate(2.64 2.64) scale(.78)">
          <path d="M3.2 6.8c1.3-1 2 .9 3.2-.1 1.1-.9 1.8.8 2.9-.2 1-.8 1.7.7 2.7-.1 1.3-1 2.1.9 3.4-.2 1.1-.8 2 .5 3.2 0" />
          <path d="M4.1 11.9c.9-.5 1.3-2.2 2.1-1.8.7.4-.2 2.1.7 2.1 1 0 1.5-1.8 2.5-1.5.9.3.4 1.9 1.3 1.9 1.1 0 1.5-2.5 2.6-2.2.8.2.2 2 .9 2.1 1 .2 1.7-1.3 2.8-1 1 .3 1.5.8 2.8.3" />
          <path d="M3.5 17.3c1.5-1 2.4.7 3.8-.2 1.2-.8 2.1.8 3.3-.1 1-.8 1.8.5 2.9-.1 1.4-.8 2.5.5 4.1-.2" />
        </g>
      </svg>
    </a>
  </nav>
</div>
