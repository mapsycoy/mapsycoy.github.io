---
import { blogTags, normalizeBlogTag, type BlogTag } from "../data/blog";
import { defaultLanguage, type Language } from "../utils/i18n";

type Props = {
  lang?: Language;
  activeTag?: BlogTag;
  activeNotes?: boolean;
};

const { lang = defaultLanguage, activeTag, activeNotes = false } = Astro.props;
const languagePrefix = lang === defaultLanguage ? "" : `/${lang}`;
const allPath = `${languagePrefix}/blog/`;
const tagPath = (tag: BlogTag) => `${languagePrefix}/blog/tag/${normalizeBlogTag(tag)}/`;
const notesPath = `${languagePrefix}/blog/notes/`;
---

<div class="blog-filters">
  <nav class="works-filter blog-filter-row" aria-label={lang === "ko" ? "블로그 카테고리" : "Blog categories"}>
    <a class:list={["work-filter-button", !activeTag && !activeNotes && "is-active"]} href={allPath} aria-current={!activeTag && !activeNotes ? "page" : undefined}>All</a>
    {blogTags.map((tag) => (
      <a class:list={["work-filter-button", activeTag === tag && "is-active"]} href={tagPath(tag)} aria-current={activeTag === tag ? "page" : undefined}>{tag}</a>
    ))}
    <a class:list={["work-filter-button", "blog-notes-entry", activeNotes && "is-active"]} href={notesPath} aria-current={activeNotes ? "page" : undefined} aria-label="Notes">
      <span class="blog-notes-entry-label">Notes</span>
      <svg class="blog-notes-entry-icon" viewBox="0 0 24 24" aria-hidden="true">
        <defs>
          <filter id="notes-scribble" x="-15%" y="-15%" width="130%" height="130%">
            <feTurbulence type="fractalNoise" baseFrequency="0.08 0.16" numOctaves="2" seed="7" result="noise" />
            <feDisplacementMap in="SourceGraphic" in2="noise" scale="0.75" xChannelSelector="R" yChannelSelector="G" />
          </filter>
        </defs>
        <g class="blog-notes-scribble" filter="url(#notes-scribble)">
          <g class="blog-notes-page">
            <path class="pressure-thin" d="M3.1 3.1c2.5-.2 5.2-.3 7.8-.2" />
            <path class="pressure-heavy" d="M10.7 2.9c2 0 3.8.1 5.4.2" />
            <path class="pressure-light" d="M15.9 3.1l5 4.7" />
            <path class="pressure-heavy" d="M20.9 7.6c.2 1.7.2 3.3.1 4.8" />
            <path class="pressure-thin" d="M21 12.1c0 2.8-.2 5.5-.4 7.6" />
            <path class="pressure-light" d="M19.8 20.1c-2.7.2-5.6.3-8.4.2" />
            <path class="pressure-heavy" d="M11.6 20.3c-2.8 0-5.4-.1-7.6-.3" />
            <path class="pressure-thin" d="M3.8 20c-.3-2.4-.4-5.1-.4-7.6" />
            <path class="pressure-heavy" d="M3.4 12.6c-.1-3.1-.1-6.2 0-8.6" />
          </g>
          <path class="blog-notes-fold" d="M16.2 3.5c-.1 1.5 0 3 .3 4.5 1.5-.2 2.8 0 4.2.2" />
          <path d="M6.5 8.6c.9-.6 1.5.5 2.4-.1.8-.6 1.4.5 2.2-.1.9-.6 1.6.5 2.5-.1.9-.5 1.6.4 2.5-.1" />
          <path d="M6.4 12.2c.7-.4 1-1.3 1.7-1.1.6.2.1 1.3.8 1.3.7 0 1.1-1.2 1.9-.9.7.2.4 1.2 1.1 1.2.8 0 1.2-1.4 2-1.2.6.2.3 1.2 1 1.3.7.1 1.2-.8 2-.5" />
          <path d="M6.5 15.9c1.1-.6 1.8.4 2.9-.1.9-.5 1.6.5 2.5-.1.8-.5 1.5.4 2.3-.1.9-.5 1.7.3 2.6-.2" />
        </g>
      </svg>
    </a>
  </nav>
</div>
