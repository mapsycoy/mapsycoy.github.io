---
interface Props {
  locations?: string[];
  context?: "home" | "work";
}

const { locations = ["seongbuk"], context = "home" } = Astro.props;
const points: Record<string, { x: number; y: number }> = {
  jongno: { x: 54, y: 29 },
  gangnam: { x: 73, y: 59 },
  seongdong: { x: 67, y: 44 },
  mapo: { x: 36, y: 42 },
  seongbuk: { x: 60.2, y: 25.8 },
  seocho: { x: 65, y: 67 },
  suwon: { x: 66, y: 88 },
  songdo: { x: -8, y: 58 }
};
const visiblePoints = locations.map((location) => points[location.trim().toLowerCase()]).filter(Boolean);
const hasExternalPoint = locations.some((location) => ["suwon", "songdo"].includes(location.trim().toLowerCase()));
const hasFlightRoute = locations.some((location) => location.trim().toLowerCase() === "kyoto");
---

<!-- District geometry derived from Seoul municipality boundary data, simplified for this small display. -->
<span class:list={["home-location-map", "home-seoul-map", context === "work" && "work-location-map"]} aria-hidden="true">
  <svg viewBox={hasFlightRoute ? "-24 0 126 82" : hasExternalPoint ? "-12 0 126 92" : "0 0 102 78"} role="img">
    <defs>
      <filter id="seoul-scribble" x="-12%" y="-12%" width="124%" height="124%">
        <feTurbulence type="fractalNoise" baseFrequency="0.055 0.12" numOctaves="2" seed="7" result="noise" />
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="3.4" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </defs>
    <g class="seoul-scribble-geometry" filter="url(#seoul-scribble)">
    <g class="home-seoul-map-districts">
      <path d="M68.6 4L69 12.1L68.9 16.6L66.2 19.5L62.5 15.5L59.4 14L60.2 9.3L58.4 4.8L61.6.1L65.5 1.9L68.1 3.4Z" />
