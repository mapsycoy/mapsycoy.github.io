    {visiblePoints.map((point) => <circle class="home-seoul-map-location-point" cx={point.x} cy={point.y} r="2.6" />)}
    {hasFlightRoute && (
      <g class="work-location-flight-plane" transform="translate(-11 53) rotate(-135) scale(1.05)">
