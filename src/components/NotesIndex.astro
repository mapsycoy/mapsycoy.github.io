---
import Layout from "../layouts/Layout.astro";
import BlogFilterNav from "./BlogFilterNav.astro";
import NotesSearch from "./NotesSearch.astro";
import NoteGraph from "./NoteGraph.astro";
import type { NoteEntry } from "../data/notes";
import { createNoteGraph } from "../data/noteGraph";
import type { Language } from "../utils/i18n";

type Props = {
  notes: NoteEntry[];
  lang: Language;
};

const { notes, lang } = Astro.props;
const graph = createNoteGraph(notes, lang);
const copy = lang === "ko"
  ? {
      description: "진행 중인 생각의 공개 지도. 서로 연결되고, 수정되며, 계속 확장됩니다.",
    }
  : {
      description: "A public map of thoughts in progress. Connected, revised, and extended over time. Written in Korean.",
    };
---

<Layout title="Notes" description={copy.description} lang={lang}>
  <BlogFilterNav lang={lang} activeNotes />
  <div class="blog-inline-search notes-inline-search" style="min-height: 48px;">
    <NotesSearch lang={lang} />
  </div>
  <NoteGraph graph={graph} mode="global" lang={lang} />
</Layout>
