---
import { getSeriesEntryPath, getSeriesEntryTitle, type SeriesEntry } from "../data/seriesEntries";
import { formatSeriesNumber, series, type SeriesId } from "../data/series";
import { defaultLanguage, localize, type Language } from "../utils/i18n";

type Props = { entries: SeriesEntry[]; index: number; seriesId: SeriesId; lang?: Language; placement: "header" | "footer" };
const { entries, index, seriesId, lang = defaultLanguage, placement } = Astro.props;
const languagePrefix = lang === defaultLanguage ? "" : `/${lang}`;
const previous = entries[index - 1];
const next = entries[index + 1];
const meta = series[seriesId];
const seriesPath = `${languagePrefix}/blog/#series-${seriesId}`;
---

{placement === "header" ? (
  <p class="blog-series-context">
    <a href={seriesPath}><span class="blog-series-context-number">Series {formatSeriesNumber(meta.number)}</span><span aria-hidden="true"> · </span><span>{localize(meta.title, lang)}</span></a>
    <span aria-hidden="true"> · </span><span>{index + 1}/{entries.length}</span>
  </p>
) : (
  <nav class="blog-series-navigation" aria-label={lang === "ko" ? "시리즈 글 탐색" : "Series navigation"}>
    <span class="blog-series-navigation-previous">
      {previous && <a href={getSeriesEntryPath(previous, lang)}><span class="blog-series-navigation-arrow" aria-hidden="true">&larr;</span><span class="blog-series-navigation-text">{lang === "ko" ? "이전 글" : "Previous"}: {getSeriesEntryTitle(previous, lang)}</span></a>}
    </span>
    <span class="blog-series-navigation-next">
      {next && <a href={getSeriesEntryPath(next, lang)}><span class="blog-series-navigation-text">{lang === "ko" ? "다음 글" : "Next"}: {getSeriesEntryTitle(next, lang)}</span><span class="blog-series-navigation-arrow" aria-hidden="true">&rarr;</span></a>}
    </span>
  </nav>
)}
