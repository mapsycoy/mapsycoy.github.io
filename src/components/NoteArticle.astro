---
import { render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import TocRail from "./TocRail.astro";
import { formatNoteDate, getNoteStatusLabel, type NoteEntry } from "../data/notes";
import { withLanguage, type Language } from "../utils/i18n";

type Props = {
  note: NoteEntry;
  lang: Language;
};

const { note, lang } = Astro.props;
const { Content, headings } = await render(note);
const tocHeadings = headings.filter((heading) => heading.depth === 2);
const { title, titleEn, date, updated, status, tags } = note.data;
const localizedTitle = lang === "en" ? titleEn : title;
const copy = lang === "ko"
  ? {
      description: "통계와 연구방법을 공부하며 쌓은 작업 로그.",
      tags: "태그",
      toc: "목차",
    }
  : {
      description: "A study note and learning log. Written in Korean.",
      tags: "Tags",
      toc: "Contents",
    };
---

<Layout
  title={localizedTitle}
  description={copy.description}
  lang={lang}
  ogType="article"
  publishedTime={date.toISOString()}
  modifiedTime={updated?.toISOString()}
>
  <article class="note-post" data-pagefind-body>
    <div class="pagefind-meta" hidden aria-hidden="true">
      <span data-pagefind-filter="Kind:Note"></span>
      <span data-pagefind-meta={"status:" + status}></span>
      <span data-pagefind-meta={`date:${(updated ?? date).toISOString()}`}></span>
      <span data-pagefind-meta={`tags:${tags.join(" ")}`}></span>
    </div>
    <header class="note-header">
      <a class="work-back-link note-back-link" href={withLanguage(lang, "/blog/notes")}>← notes</a>
      <div class="note-header-meta">
        <span class={`note-status note-status-${status}`}>{getNoteStatusLabel(status, lang)}</span>
        <span aria-hidden="true">·</span>
        <time datetime={date.toISOString()}>{formatNoteDate(date, lang)}</time>
        {updated && (
          <>
            <span aria-hidden="true">·</span>
            <time datetime={updated.toISOString()}>upd {formatNoteDate(updated, lang)}</time>
          </>
        )}
      </div>
      <h1 class:list={["note-title", lang === "ko" && "ko-title"]}>{localizedTitle}</h1>
    </header>

    <div class="note-content-shell">
      <TocRail headings={tocHeadings} label={copy.toc} />

      <div class="note-body">
        <Content />
      </div>
    </div>

    <footer class="note-footer">
      {tags.length > 0 && (
        <ul class="note-tags" aria-label={copy.tags}>
          {tags.map((tag, index) => <li>{index > 0 && <span aria-hidden="true">·</span>} {tag}</li>)}
        </ul>
      )}
    </footer>
  </article>
</Layout>
