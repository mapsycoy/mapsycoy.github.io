---
import { render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import TocRail from "./TocRail.astro";
import BlogSeriesNav from "./BlogSeriesNav.astro";
import NoteGraph from "./NoteGraph.astro";
import { formatNoteDate, getNoteStatusLabel, getNoteTitle, type NoteEntry } from "../data/notes";
import { createNoteGraph } from "../data/noteGraph";
import { getNotes } from "../data/notes";
import { getBlogPosts } from "../data/blog";
import { getSeriesEntryPosition } from "../data/seriesEntries";
import { formatSeriesNumber, series } from "../data/series";
import { localize, withLanguage, type Language } from "../utils/i18n";

type Props = {
  note: NoteEntry;
  lang: Language;
};

const { note, lang } = Astro.props;
const { Content, headings } = await render(note);
const tocHeadings = headings.filter((heading) => heading.depth === 2);
const { date, updated, status, tags } = note.data;
const localizedTitle = getNoteTitle(note, lang);
const [allPosts, allNotes] = await Promise.all([getBlogPosts(), getNotes()]);
const graph = createNoteGraph(allNotes, lang);
const seriesPosition = getSeriesEntryPosition(allPosts, allNotes, { kind: "note", item: note });
const copy = lang === "ko"
  ? {
      description: "통계와 연구방법을 공부하며 쌓은 작업 로그.",
      tags: "태그",
      toc: "목차",
    }
  : {
      description: "A study note and learning log. Written in Korean.",
      tags: "Tags",
      toc: "Contents",
    };
---

<Layout
  title={localizedTitle}
  description={copy.description}
  lang={lang}
  ogType="article"
  publishedTime={date?.toISOString()}
  modifiedTime={updated?.toISOString()}
>
  <article class="note-post" data-pagefind-body>
    <div class="pagefind-meta" hidden aria-hidden="true">
      <span data-pagefind-filter="Kind:Note"></span>
      <span data-pagefind-meta={"status:" + status}></span>
      {(updated ?? date) && <span data-pagefind-meta={`date:${(updated ?? date)?.toISOString()}`}></span>}
      <span data-pagefind-meta={`tags:${tags.join(" ")}`}></span>
      {seriesPosition && <span data-pagefind-filter={`Series:${localize(series[seriesPosition.seriesId].title, lang)}`}></span>}
      {seriesPosition && <span data-pagefind-meta={`series:Series ${formatSeriesNumber(series[seriesPosition.seriesId].number)} · ${seriesPosition.index + 1}/${seriesPosition.entries.length}`}></span>}
    </div>
    <a class="work-back-link" href={withLanguage(lang, "/blog/notes")} aria-label="Back to Notes">&#8592;</a>
    <header class="note-header">
      <div class="note-header-meta">
        <span class={`note-status note-status-${status}`}>{getNoteStatusLabel(status, lang)}</span>
        {date && <><span aria-hidden="true">·</span><time datetime={date.toISOString()}>{formatNoteDate(date, lang)}</time></>}
        {updated && (
          <>
            <span aria-hidden="true">·</span>
            <time datetime={updated.toISOString()}>upd {formatNoteDate(updated, lang)}</time>
          </>
        )}
      </div>
      <h1 class:list={["note-title", lang === "ko" && "ko-title"]}>{localizedTitle}</h1>
      {seriesPosition && <BlogSeriesNav entries={seriesPosition.entries} index={seriesPosition.index} seriesId={seriesPosition.seriesId} lang={lang} placement="header" />}
    </header>

    <div class="note-content-shell">
      <TocRail headings={tocHeadings} label={copy.toc} />

      <div class="note-body">
        <Content />
      </div>
    </div>

    <NoteGraph graph={graph} mode="local" currentId={note.id} lang={lang} />
    <footer class="note-footer">
      {tags.length > 0 && (
        <ul class="work-tags" aria-label={copy.tags}>
          {tags.map((tag) => <li>{tag}</li>)}
        </ul>
      )}
    </footer>
    {seriesPosition && <BlogSeriesNav entries={seriesPosition.entries} index={seriesPosition.index} seriesId={seriesPosition.seriesId} lang={lang} placement="footer" />}
  </article>
</Layout>
