---
import { getWorkPdfUrls } from "../utils/workPdf.mjs";
import { localize, type Language, type LocalizedText } from "../utils/i18n";

interface Props {
  url: string;
  title?: LocalizedText;
  caption?: LocalizedText;
  lang: Language;
}

const { url, title, caption, lang } = Astro.props;
const urls = getWorkPdfUrls(url);
const authoredTitle = localize(title, lang).trim();
const documentTitle = authoredTitle || (lang === "ko" ? "PDF 문서" : "PDF document");
const documentCaption = localize(caption, lang).trim();
---

{urls && (
  <figure class="work-pdf">
    {authoredTitle && <div class="work-pdf-title">{authoredTitle}</div>}
    <iframe
      src={urls.previewUrl}
      title={`${documentTitle} — ${lang === "ko" ? "PDF 미리보기" : "PDF preview"}`}
      loading="lazy"
      allowfullscreen
    ></iframe>
    {documentCaption && <figcaption>{documentCaption}</figcaption>}
  </figure>
)}

<style>
  .work-pdf { margin: 24px 0 0; min-width: 0; }
  .work-pdf:first-child { margin-top: 0; }
  .work-pdf-title { padding: 12px 0; border-top: 1px solid var(--line); font-size: 0.92rem; font-weight: 500; overflow-wrap: anywhere; }
  iframe { display: block; box-sizing: border-box; width: 100%; height: clamp(360px, 75vh, 860px); height: clamp(360px, 75svh, 860px); border: 1px solid var(--line); background: var(--soft); }
  figcaption { margin-top: 10px; color: var(--muted); font-size: 0.86rem; line-height: 1.5; text-align: center; overflow-wrap: anywhere; }
  @media (max-width: 600px) {
    iframe { height: clamp(320px, 65vh, 640px); height: clamp(320px, 65svh, 640px); }
  }
</style>
