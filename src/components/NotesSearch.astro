---
import { defaultLanguage, type Language } from "../utils/i18n";

type Props = { lang?: Language };
const { lang = defaultLanguage } = Astro.props;
const copy = lang === "ko"
  ? {
      label: "학습 노트 검색",
      placeholder: "노트 검색",
      clear: "지우기",
      searching: "검색 중…",
      result: "개 노트",
      empty: "일치하는 노트가 없습니다.",
    }
  : {
      label: "Search study notes",
      placeholder: "Search notes",
      clear: "Clear",
      searching: "Searching…",
      result: " notes",
      empty: "No matching notes.",
    };
---

<section class="notes-search notes-graph-search" aria-label={copy.label} data-notes-search>
  <form class="notes-search-form" role="search">
    <label class="sr-only" for="notes-search-input">{copy.label}</label>
    <div class="blog-search-input-wrap notes-search-input-wrap">
      <button class="blog-search-submit notes-search-submit" type="submit" aria-label={copy.label}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6" /><path d="m15.5 15.5 4 4" /></svg>
      </button>
      <input id="notes-search-input" class="blog-search-input notes-search-input" type="search" placeholder={copy.placeholder} autocomplete="off" aria-describedby="notes-search-status" />
      <button class="blog-search-clear notes-search-clear" type="button" hidden>{copy.clear}</button>
    </div>
  </form>
  <p id="notes-search-status" class="notes-search-status" aria-live="polite"></p>
</section>

<script is:inline define:vars={{ copy }}>
  (() => {
    const setupNotesSearch = async () => {
      const mount = document.querySelector("[data-notes-search]");
      const graphMount = document.querySelector('[data-note-graph][data-mode="global"]');
      if (!mount || !graphMount || mount.dataset.ready) return;
      mount.dataset.ready = "loading";

      const form = mount.querySelector(".notes-search-form");
      const input = mount.querySelector(".notes-search-input");
      const clear = mount.querySelector(".notes-search-clear");
      const status = mount.querySelector(".notes-search-status");
      const dataNode = graphMount.querySelector('script[type="application/json"]');
      if (!form || !input || !clear || !status || !dataNode) return;

      let graphData;
      try { graphData = JSON.parse(dataNode.textContent || "{}"); } catch { return; }
      const nodes = graphData.nodes || [];
      let pagefind;
      let matches = [];
      let searchId = 0;
      let debounceTimer;

      const normalizePath = (value = "") => {
        try {
          const path = new URL(value, window.location.origin).pathname;
          return path.replace(/^\/(ko|en)(?=\/)/, "").replace(/\/+$/, "") || "/";
        } catch {
          return String(value).replace(/^\/(ko|en)(?=\/)/, "").replace(/\/+$/, "") || "/";
        }
      };
      const nodeByPath = new Map(nodes.map((node) => [normalizePath(node.url), node]));
      const dispatchMatches = (term, matchedNodes) => {
        matches = matchedNodes;
        document.dispatchEvent(new CustomEvent("notes-graph-search", {
          detail: {
            query: term,
            matchIds: matchedNodes.map((node) => node.id),
            primaryUrl: matchedNodes[0]?.url || "",
          },
        }));
        status.textContent = !term ? "" : matchedNodes.length ? matchedNodes.length + copy.result : copy.empty;
      };
      const localMatches = (term) => {
        const normalized = term.toLocaleLowerCase();
        return nodes.filter((node) =>
          [node.title, node.graphLabel, ...(node.tags || [])]
            .join(" ")
            .toLocaleLowerCase()
            .includes(normalized)
        );
      };
      const runSearch = async () => {
        const term = input.value.trim();
        clear.hidden = !term;
        const currentSearchId = ++searchId;
        if (!term) {
          dispatchMatches("", []);
          return;
        }

        const immediate = localMatches(term);
        dispatchMatches(term, immediate);
        if (!pagefind) return;

        status.textContent = copy.searching;
        try {
          const response = await pagefind.search(term, { filters: { Kind: "Note" } });
          if (currentSearchId !== searchId) return;
          const found = [];
          for (const result of response.results) {
            const item = await result.data();
            const node = nodeByPath.get(normalizePath(item.url));
            if (node && !found.some((candidate) => candidate.id === node.id)) found.push(node);
          }
          dispatchMatches(term, found);
        } catch {
          pagefind = null;
          dispatchMatches(term, immediate);
        }
      };

      form.addEventListener("submit", (event) => {
        event.preventDefault();
        if (matches[0]) window.location.href = matches[0].url;
      });
      input.addEventListener("input", () => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(runSearch, 160);
      });
      clear.addEventListener("click", () => {
        input.value = "";
        runSearch();
        input.focus();
      });

      try { pagefind = await import("/pagefind/pagefind.js"); } catch { pagefind = null; }
      mount.dataset.ready = "true";
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", setupNotesSearch, { once: true });
    } else {
      setupNotesSearch();
    }
    document.addEventListener("astro:page-load", setupNotesSearch);
  })();
</script>
