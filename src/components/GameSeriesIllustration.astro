---
// Game shapes and a service app sit on open platforms supported entirely from below.
---
<svg class="game-series-illustration blog-series-illustration" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 80" width="128" height="80" fill="none" stroke="currentColor" stroke-width="1.14" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <!-- Flat, hand-drawn game shapes with varied sizes and a loose, bouncing silhouette. -->
  <path d="m9.1 8.3-1.8-3.4m36.1 4.3 3.4-2.6" stroke-width=".92" />
  <g transform="translate(18 16) rotate(-24)">
    <path d="M-2-8q-3.5-.4-3.3 3.2l.1 1.8-2.7-.1q-3.8-.1-3.2 3.4-.3 3.1 3.2 3l2.8.1-.1 2.7q-.3 3.7 3.3 3.3 3.2.3 3.1-3.1l.1-2.9 2.9.1q3.6.2 3.3-3.2.2-3.2-3.1-3.3l-3 .1.1-2.2Q2-8.4-2-8Z" fill="var(--token-face)" stroke-width="1.46" />
  </g>
  <!-- A plump reward star contrasts with the service's rounded-square app icon. -->
  <g transform="translate(35 28) rotate(12)">
    <path d="M-2-11q2-3 4 1l2 5 6 1q4 1 0 4L6 4l1 6q0 4-4 1L-1 8l-5 3q-4 2-3-3l1-5-4-3q-3-3 2-4l5-1Z" fill="var(--token-face)" stroke-width="1.46" />
  </g>
  <g transform="translate(14.5 36) rotate(-18)">
    <path d="M-6.2.4q-.8-6 5.3-6.8 6.8-.3 7.2 5.8.6 6-5.6 6.8-6.3.7-6.9-5.8Z" fill="var(--token-face)" />
  </g>
  <!-- An independent app icon, with just one simple service mark. -->
  <path d="M86.1 23.3q-.7-8.5 6.7-8.1l16 .3q7-.3 6.3 7.2l-.3 12.6q.4 7-6.8 6.8l-15.8-.5q-7.2.3-6.4-7.3Z" stroke-width="1.46" />
  <path d="m93.4 28.4 6 5 4.1-5.2 5.1-6.1" stroke-width="1.46" />
  <!-- Shallow platforms and short stems keep all structural lines below the objects. -->
  <path d="m8.6 47 18.3.4 22-.6q-6 4.4-19.6 4.1-13 .5-20.7-3.9Z" />
  <path d="M29.3 51q-.4 3.1.2 5.7" stroke-width=".92" />
  <path d="m80.3 46.1 18.8-.4 21 .5q-6.4 4.1-20.2 3.5-13 .3-19.6-3.6Z" />
  <path d="m100.2 49.9-.4 4.9" stroke-width=".92" />
  <!-- A low balance arm and central fulcrum, with no scale marks or target ratio. -->
  <path d="m29.5 56.7 16.9-.6 17.2.3 18-1.1 18.2-.5" stroke-width="1.46" />
  <path d="m63.6 56.8-5 8.5-6 8.2m11-16.7 5.8 8.6 5.3 8.3m-22.1-.2 10.8.5 11.8-.3" stroke-width="1.46" />
</svg>

<style>
  .game-series-illustration { color: inherit; flex-shrink: 0; --token-face: var(--bg); }
  :global(.series-card:hover) .game-series-illustration { --token-face: var(--soft); }
</style>
