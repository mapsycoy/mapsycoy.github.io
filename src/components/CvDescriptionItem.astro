---
import { marked } from "marked";
import { localize, type Language } from "../utils/i18n";

type Props = {
  line: any;
  lang: Language;
  showMarker: boolean;
};

const { line, lang, showMarker } = Astro.props;
const isAward = line?.award === true;
const html = marked
  .parseInline(localize(line?.line ?? line, lang))
  .replaceAll("<a href=", '<a target="_blank" rel="noreferrer" href=');
---

<li class:list={[isAward && "cv-entry-description-award"]} style="position:relative;list-style:none;">
  {showMarker && (
    <span aria-hidden="true" style="position:absolute;top:0;left:-1.15em;width:1em;height:1.42em;display:flex;align-items:center;justify-content:center;line-height:1.42;">
      {isAward ? (
        <svg viewBox="0 0 24 24" style="display:block;width:0.78em;height:0.78em;fill:currentColor;" aria-hidden="true">
          <path d="M6 2h12v6a6 6 0 0 1-5 5.92V18h3a1 1 0 0 1 1 1v3H7v-3a1 1 0 0 1 1-1h3v-4.08A6 6 0 0 1 6 8V2Zm0 3H2v3a5 5 0 0 0 5 5v-2a3 3 0 0 1-3-3V7h2V5Zm12 0v2h2v1a3 3 0 0 1-3 3v2a5 5 0 0 0 5-5V5h-4Z" />
        </svg>
      ) : (
        <span style="display:block;font-size:1em;line-height:1;">&#8226;</span>
      )}
    </span>
  )}
  <span set:html={html} />
</li>
